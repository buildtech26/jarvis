# Copia questo file in .env e compila.

# Bot Telegram: crealo con @BotFather e incolla il token
TELEGRAM_TOKEN=
# Il tuo ID numerico Telegram (te lo dice @userinfobot, o il bot stesso alla prima scrittura)
TELEGRAM_UTENTE=

# Gmail: serve la verifica in due passaggi attiva, poi una password per le app da
# https://myaccount.google.com/apppasswords (16 lettere, gli spazi non contano)
GMAIL_INDIRIZZO=
GMAIL_PASSWORD_APP=

# Voli di tutte le compagnie (Google Flights): chiave gratuita da https://serpapi.com, 250 ricerche/mese.
# Vuota = solo Ryanair
SERPAPI_KEY=

# Cervello principale: chiave da https://aistudio.google.com/apikey 
GEMINI_API_KEY=
# Modelli Gemini in ordine di preferenza, separati da virgola (si passa al successivo se uno non risponde)
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Voce italiana: it-IT-DiegoNeural, it-IT-GiuseppeNeural, it-IT-ElsaNeural, it-IT-IsabellaNeural
JARVIS_VOCE=it-IT-DiegoNeural
# Alza se si attiva da solo, abbassa se non ti sente (0.3 - 0.8)
WAKEWORD_SOGLIA=0.5

# Password dello zip cifrato del backup giornaliero in OneDrive\Backup\Jarvis (backup.py). Tienila anche fuori dal PC:
# se il disco si rompe, il .env è proprio dentro lo zip
BACKUP_PASSWORD=

# Password della chat nel browser (web.py), almeno 12 caratteri: la pagina è raggiungibile da internet con Tailscale
# Funnel, quindi una password lunga e usata solo qui. Vuota = pagina spenta
WEB_PASSWORD=

# Indirizzo pubblico della pagina (quello stampato da 'tailscale funnel'): il controllo delle 8 verifica che risponda
WEB_INDIRIZZO=
